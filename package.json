{
    "name": "tvm-discord-bot",
    "version": "1.0.0",
    "description": "TVM Discord bot for roster-based membership verification and private shoot workspaces",
    "main": "src/app/App.js",
    "scripts": {
        "start": "node --env-file-if-exists=.env.local src/app/index.js",
        "test": "node --test test/*.test.js",
        "roster:check": "node scripts/check-roster.js",
        "discord:check": "node --env-file=.env.local scripts/check-discord.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm test"
    },
    "author": "TVM contributors (based on EmailVerify by Lars Benedikt Kaesberg)",
    "license": "AGPL-3.0-or-later",
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "csv-parse": "^7.0.3",
        "discord.js": "^14.25.1",
        "luxon": "^3.7.2",
        "nodemailer": "^10.0.13",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.9"
    },
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/TheTexta/tvm-discord-bot.git"
    },
    "bugs": {
        "url": "https://github.com/TheTexta/tvm-discord-bot/issues"
    },
    "homepage": "https://github.com/TheTexta/tvm-discord-bot#readme"
}
